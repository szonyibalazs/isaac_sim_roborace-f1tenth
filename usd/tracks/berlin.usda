    def "Physics"
    {
        def Material "TrackPhysMat" (
            apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }
    }

    def "Looks"
    {
        def Material "Black_Fabric"
        {
            token outputs:surface.connect = </World/Looks/Black_Fabric/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Shiny_Aluminium"
        {
            token outputs:surface.connect = </World/Looks/Shiny_Aluminium/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Shiny_Aluminium/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../../assets/raw/track/textures/metal_0041_color_4k.png@
                float4 inputs:scale = (0.7059, 0.702, 0.7059, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/Shiny_Aluminium/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

    def Cube "Ground" (
        apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </World/Physics/TrackPhysMat> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.25, 0.25, 0.25)]
        double size = 1
        float3 xformOp:scale = (200, 200, 0.1)
        double3 xformOp:translate = (0, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Lights"
    {
        def DomeLight "Dome"
        {
            float inputs:intensity = 600
        }

        def DistantLight "Sun"
        {
            float inputs:intensity = 2500
            float3 xformOp:rotateXYZ = (-50, 0, 30)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }
}

